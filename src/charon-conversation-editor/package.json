{
  "$schema": "https://raw.githubusercontent.com/gamedevware/charon-extensions/refs/heads/main/package.json.schema.json",
  "name": "charon-conversation-editor",
  "version": "0.0.42",
  "description": "",
  "keywords": [
    "charon",
    "extensions",
    "conversation editor"
  ],
  "homepage": "https://github.com/gamedevware/charon-extensions",
  "bugs": "https://github.com/gamedevware/charon-extensions/issues",
  "author": "GameDevWare, Denis Zykov",
  "license": "MIT",
  "config": {
    "customEditors": [
      {
        "id": "ext-conversation-editor",
        "selector": "ext-conversation-editor",
        "name": "Conversation Editor",
        "type": [
          "Schema"
        ]
      }
    ],
    "customActions": [
      {
        "name": "Create Conversation Schema",
        "functionName": "createConversationSchema",
        "location": "new-schema-menu",
        "icon": "emoji/speech_balloon"
      }
    ]
  },
  "main": "index.js",
  "files": [
    "assets/index.css"
  ],
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build && cd dist && npm pack",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "charon-extensions": "file:../charon-extensions",
    "dagre": "^0.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "rxjs": "^7.8.2",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "ts-essentials": "^10.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5"
  }
}