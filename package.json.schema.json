{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "allOf": [
        {
            "$ref": "https://json.schemastore.org/package.json"
        },
        {
            "type": "object",
            "properties": {
                "config": {
                    "type": "object",
                    "properties": {
                        "customEditors": {
                            "type": "array",
                            "nullable": true,
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "description": "Unique identifier of the field editor. Typically starts with 'ext', e.g., 'ext-color-picker-hex'."
                                    },
                                    "type": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "enum": [
                                                "Property",
                                                "Grid",
                                                "Schema"
                                            ]
                                        },
                                        "description": "Editor usage type:\n- 'Property' — used as a field editor in forms.\n- 'Grid' — used as a cell editor in grids.\n- 'Schema' — replaces the entire form, e.g., with a graph or node editor."
                                    },
                                    "icon": {
                                        "type": "string"
                                    },
                                    "selector": {
                                        "type": "string",
                                        "description": "Custom HTML element name registered with 'customElements.define'. Typically starts with 'ext', e.g., 'ext-color-picker'."
                                    },
                                    "name": {
                                        "type": "string",
                                        "description": "Display name of the field editor. Shown in the UI, e.g., 'Color Picker (HEX)'."
                                    },
                                    "specification": {
                                        "type": "string",
                                        "description": "Additional key-value configuration parameters for the editor in URLSearchParams format. Example: 'palette=material&alpha=true'. These values ​​will be pushed into the Schema/Property specification dictionary at the time the Schema/Property is being created."
                                    },
                                    "dataTypes": {
                                        "type": "array",
                                        "nullable": true,
                                        "items": {
                                            "type": "string",
                                            "enum": [
                                                "Text",
                                                "LocalizedText",
                                                "Logical",
                                                "Time",
                                                "Date",
                                                "Number",
                                                "Integer",
                                                "PickList",
                                                "MultiPickList",
                                                "Document",
                                                "DocumentCollection",
                                                "Reference",
                                                "ReferenceCollection",
                                                "Formula"
                                            ]
                                        },
                                        "description": "List of supported data types that this editor can handle."
                                    }
                                },
                                "required": [
                                    "id",
                                    "type",
                                    "selector",
                                    "name"
                                ]
                            }
                        },
                        "customActions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "tooltip": {
                                        "type": "string"
                                    },
                                    "icon": {
                                        "type": "string"
                                    },
                                    "functionName": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Name of the exported function to call with the action context. Mutually exclusive with 'pageId' — set exactly one."
                                    },
                                    "pageId": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Id of a page in this same package's own 'customPages'. When set, the action navigates to that page instead of calling a function. Mutually exclusive with 'functionName' — set exactly one."
                                    },
                                    "location": {
                                        "type": "string",
                                        "enum": [
                                            "new-schema-menu",
                                            "document-action-menu",
                                            "document-list-action-menu",
                                            "side-navigation-menu"
                                        ]
                                    }
                                },
                                "required": [
                                    "name",
                                    "location"
                                ],
                                "oneOf": [
                                    {
                                        "required": ["functionName"],
                                        "not": { "required": ["pageId"] }
                                    },
                                    {
                                        "required": ["pageId"],
                                        "not": { "required": ["functionName"] }
                                    }
                                ],
                                "additionalProperties": false
                            }
                        },
                        "customPages": {
                            "type": ["array", "null"],
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "id",
                                    "selector",
                                    "title"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Unique identifier of the page, used as a URL segment. Typically starts with 'ext', e.g., 'ext-sample-page'."
                                    },
                                    "selector": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Custom HTML element name registered with 'customElements.define'. Typically starts with 'ext', e.g., 'ext-sample-page-element'."
                                    },
                                    "title": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Browser tab title and breadcrumb fallback text for the page."
                                    },
                                    "breadcrumb": {
                                        "type": "string",
                                        "description": "Breadcrumb text for the page. Falls back to 'title' when absent."
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}